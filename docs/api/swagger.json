        "tags": [
          "Produtos"
        ],
        "summary": "Buscar Produto",
        "description": "Busca um produto ativo específico pelo id. 404 se não existir ou estiver inativo.",
        "operationId": "buscar_produto_produtos__produto_id__get",
        "parameters": [
          {
            "name": "produto_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Produto Id"
            }
          }
        ],
        "responses": {
